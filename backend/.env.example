# ==============================================================================
# EventBeep Backend Environment Configuration Example
# Copy this file to .env and adjust values as needed for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Settings
# ------------------------------------------------------------------------------
# Port on which the HTTP server will listen (Default: 8080)
PORT=8080

# Application environment: development | staging | production (Default: development)
APP_ENV=development

# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL)
# ------------------------------------------------------------------------------
# Option 1: Full connection URL (takes precedence if set)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/eventbeep?sslmode=disable

# Option 2: Individual connection parameters (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=eventbeep
DB_SSLMODE=disable

# Connection Pool Tuning
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# ------------------------------------------------------------------------------
# LLM Entity Extraction (Google Gemini API)
# ------------------------------------------------------------------------------
# API Key for Google Gemini (leave empty to use built-in heuristic fallback)
GEMINI_API_KEY=

# Gemini model identifier (e.g., gemini-3.8-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# Background Scheduler Pipeline
# ------------------------------------------------------------------------------
# Enable or disable the automated scraping & enrichment cron pipeline (Default: true)
SCHEDULER_ENABLED=true

# Scheduler ticker interval (e.g., 24h, 12h, 1h, 30m) (Default: 24h)
SCHEDULER_INTERVAL=24h
